  - m_Id: 1767905367678976
    m_Localized: "\u672A\u89E3\u4E8B\u4EF6\u5F15\u767C\u5BE7\u975C\u793E\u5340\u7684\u7591\u554F"
    m_Metadata:
      m_Items: []
  - m_Id: 1768069251719168
    m_Localized: "\u8FD1\u671F\u5728\u4E00\u8655\u5BE7\u975C\u7684\u9109\u6751\u5730\u5340\u767C\u751F\u4E86\u4E00\u8D77\u4EE4\u4EBA\u4E0D\u5B89\u7684\u4E8B\u4EF6\uFF0C\u7531\u65BC\u76F8\u95DC\u7D30\u7BC0\u4ECD\u4E0D\u660E\u6717\uFF0C\u9010\u6F38\u5F15\u8D77\u5916\u754C\u95DC\u6CE8\u3002"
    m_Metadata:
      m_Items: []
  - m_Id: 1768161295720448
    m_Localized: "\u5C45\u6C11\u8868\u793A\uFF0C\u5728\u4E8B\u4EF6\u767C\u751F\u524D\u7684\u5E7E\u5929\u5167\uFF0C\u5C4B\u5167\u51FA\u73FE\u4E86\u4E00\u4E9B\u7D30\u5FAE\u4F46\u7570\u5E38\u7684\u8B8A\u5316\u3002\u90E8\u5206\u7269\u54C1\u4F3C\u4E4E\u5728\u6C92\u6709\u660E\u78BA\u539F\u56E0\u7684\u60C5\u6CC1\u4E0B\u88AB\u79FB\u52D5\uFF0C\u67D0\u4E9B\u5340\u57DF\u4E5F\u5448\u73FE\u51FA\u8207\u5E73\u6642\u72C0\u614B\u4E0D\u4E00\u81F4\u7684\u6D3B\u52D5\u8DE1\u8C61\u3002"
    m_Metadata:
      m_Items: []
  - m_Id: 1768211409264640
    m_Localized: "\u5118\u7BA1\u51FA\u73FE\u9019\u4E9B\u8DE1\u8C61\uFF0C\u73FE\u5834\u4E26\u672A\u767C\u73FE\u660E\u78BA\u7684\u5F37\u884C\u95D6\u5165\u6216\u5916\u90E8\u5165\u4FB5\u75D5\u8DE1\uFF0C\u4F7F\u8ABF\u67E5\u4EBA\u54E1\u96E3\u4EE5\u5224\u65B7\u4E8B\u4EF6\u662F\u5982\u4F55\u767C\u751F\u7684\u3002"
    m_Metadata:
      m_Items: []
  - m_Id: 1768264949555200
    m_Localized: "\u90E8\u5206\u7576\u5730\u5C45\u6C11\u5C0D\u73FE\u5834\u72C0\u614B\u8207\u7F3A\u4E4F\u5408\u7406\u89E3\u91CB\u4E4B\u9593\u7684\u843D\u5DEE\u8868\u793A\u6182\u616E\uFF0C\u8A8D\u70BA\u773C\u524D\u6240\u898B\u7684\u8B49\u64DA\u672A\u5FC5\u5B8C\u5168\u53CD\u6620\u5BE6\u969B\u767C\u751F\u7684\u7D93\u904E\u3002"
    m_Metadata:
      m_Items:
      - rid: 4943103364654956557
  - m_Id: 1768322260525056
    m_Localized: "\u7576\u5C40\u5C1A\u672A\u91D0\u6E05\u8A72\u4E8B\u4EF6\u7A76\u7ADF\u6E90\u65BC\u5916\u90E8\u4ECB\u5165\u3001\u500B\u4EBA\u884C\u70BA\uFF0C\u6216\u5176\u4ED6\u672A\u77E5\u56E0\u7D20\uFF0C\u76EE\u524D\u6848\u4EF6\u4ECD\u5728\u8ABF\u67E5\u4E2D\u3002"
    m_Metadata:
      m_Items: []
  - m_Id: 2353164421423104
    m_Localized: "\u89AA\u611B\u7684\u2014\u2014\n\n\u6211\u539F\u672C\u6253\u7B97\u628A\u4E8B\u60C5\u8AAA\u6E05\u695A\uFF0C\u4F46\u73FE\u5728\u597D\u50CF\u6C92\u6709\u90A3\u9EBC\u7C21\u55AE\u3002\n\n\u6709\u4E9B\u4E8B\u60C5\u548C\u6211\u9810\u671F\u7684\u4E0D\u4E00\u6A23\uFF0C\u6211\u4E0D\u77E5\u9053\u8A72\u4E0D\u8A72\u7167\u539F\u672C\u7684\u8A08\u756B\u9032\u884C\u3002\n\n\u5982\u679C\u6211\u6C92\u6709\u2014\u2014"
    m_Metadata:
      m_Items: []
  - m_Id: 2378827706654720
    m_Localized: "\u8A18\u5F97\u5E36\u9470\u5319\r\n\u8A18\u5F97\u95DC\u71C8"
    m_Metadata:
      m_Items: []
  - m_Id: 2516917649661952
    m_Localized: "\u91AB\u7642\u6AA2\u67E5\u7D00\u9304\u6458\u8981\uFF1A\r\n\r\n\u500B\u9AD4\u72C0\u614B\u8A55\u4F30\u6642\u9593\uFF1A08:40\r\n\r\n\u4E00\u3001\u751F\u547D\u5FB5\u8C61\uFF1A\r\n-
      \u5FC3\u7387\uFF1A\u7D04 72 \u6B21/\u5206\u9418\uFF0C\u7BC0\u5F8B\u898F\u5247\r\n-
      \u547C\u5438\u983B\u7387\uFF1A\u6BCF\u5206\u9418\u7D04 14 \u6B21\uFF0C\u7A69\u5B9A\r\n-
      \u9AD4\u6EAB\uFF1A36.7\xB0C\r\n- \u8840\u58D3\uFF1A118/76 mmHg\r\n\r\n\u4E8C\u3001\u9AD4\u8868\u6AA2\u67E5\uFF1A\r\n-
      \u672A\u89C0\u5BDF\u5230\u660E\u986F\u5916\u50B7\u3001\u7600\u9752\u6216\u6495\u88C2\u75D5\u8DE1\r\n-
      \u56DB\u80A2\u95DC\u7BC0\u6D3B\u52D5\u7BC4\u570D\u6B63\u5E38\r\n- \u624B\u90E8\u8207\u524D\u81C2\u672A\u898B\u9632\u79A6\u6027\u640D\u50B7\u8DE1\u8C61\r\n\r\n\u4E09\u3001\u795E\u7D93\u8207\u610F\u8B58\u53CD\u61C9\uFF1A\r\n-
      \u77B3\u5B54\u5C0D\u5149\u53CD\u61C9\u6B63\u5E38\r\n- \u7121\u660E\u986F\u65B9\u5411\u611F\u55AA\u5931\u6216\u53CD\u61C9\u9072\u6EEF\r\n-
      \u80A2\u9AD4\u5354\u8ABF\u6027\u672A\u898B\u7570\u5E38\r\n\r\n\u56DB\u3001\u5316\u5B78\u8207\u85E5\u7269\u6AA2\u6E2C\uFF1A\r\n-
      \u672A\u6AA2\u6E2C\u5230\u5E38\u898B\u93AE\u975C\u5291\u6216\u9EBB\u9189\u5291\u6B98\u7559\r\n-
      \u8840\u6DB2\u6A23\u672C\u4E2D\u672A\u767C\u73FE\u7570\u5E38\u5316\u5B78\u7269\u8CEA\r\n\r\n\u4E94\u3001\u5176\u4ED6\u89C0\u5BDF\uFF1A\r\n-
      \u8863\u7269\u8868\u9762\u6574\u6F54\uFF0C\u672A\u898B\u660E\u986F\u7834\u640D\r\n-
      \u9AD4\u8868\u672A\u9644\u8457\u660E\u986F\u7570\u7269\u6216\u74B0\u5883\u6B98\u7559\r\n-
      \u90E8\u5206\u751F\u7406\u6307\u6A19\u51FA\u73FE\u8F15\u5FAE\u6CE2\u52D5\uFF0C\u4F46\u4ECD\u5728\u4E00\u822C\u7BC4\u570D\u5167\r\n\r\n\u6574\u9AD4\u89C0\u5BDF\uFF1A\r\n-
      \u6240\u6709\u6AA2\u6E2C\u7D50\u679C\u5747\u672A\u986F\u793A\u986F\u8457\u7570\u5E38\r\n-
      \u7576\u524D\u72C0\u614B\u8207\u4E00\u822C\u65E5\u5E38\u6D3B\u52D5\u5F8C\u72C0\u6CC1\u76F8\u7B26"
    m_Metadata:
      m_Items: []
  - m_Id: 2527516282576896
    m_Localized: "10\u670813\u65E5\uFF08\u661F\u671F\u4E94\uFF09"
