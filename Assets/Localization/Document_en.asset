  - m_Id: 26209148928
    m_Localized: TRAVEL CONFIRMATION
    m_Metadata:
      m_Items: []
  - m_Id: 231922982912
    m_Localized: 'Booking ID: TC-784392

      Passenger Name: J. Carter


      Destination:
      London, UK

      Departure Date: October 14

      Departure Time: 05:10 AM


