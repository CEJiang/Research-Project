  m_FontData:
    m_Font: {fileID: 12800000, guid: a6ec66e1b73275b4697ac3a046fb6443, type: 3}
    m_FontSize: 24
    m_FontStyle: 0
    m_BestFit: 0
    m_MinSize: 0
    m_MaxSize: 300
    m_Alignment: 0
    m_AlignByGeometry: 0
    m_RichText: 1
    m_HorizontalOverflow: 0
    m_VerticalOverflow: 0
    m_LineSpacing: 1.1
  m_Text: 'Green lies buried, resting by the east,

    Silent watch kept in the
    depths beneath.


    Black sinks low, far from the light,

    Merging with
    earth in the shadow of night.


    White stands proud at the height of the sky,

    Farthest
    from black, where the cold winds fly.'
